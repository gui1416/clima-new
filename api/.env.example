# Copie para api/.env e ajuste. O compose lê este arquivo via env_file.
# Dentro do compose os hosts são os nomes de serviço (db, redis).
#
# DATABASE_URL é o papel da APLICAÇÃO: precisa ser NOSUPERUSER/NOBYPASSRLS, senão
# a RLS não é avaliada e o isolamento entre tenants deixa de existir — sem erro,
# sem log. DATABASE_URL_ADMIN é o dono do esquema e só é usado por migrations.
# As senhas têm de bater com as do .env da raiz.

DATABASE_URL=postgresql+psycopg://clima_app:TROQUE_SENHA_DO_APP@db:5432/clima
DATABASE_URL_ADMIN=postgresql+psycopg://clima_owner:TROQUE_SENHA_DO_DONO@db:5432/clima
REDIS_URL=redis://redis:6379

# Várias fontes públicas pedem contato identificável no User-Agent; o USGS pode
# limitar cliente anônimo em volume. Ponha um e-mail real.
USER_AGENT=ClimaGlobal/0.1 (+seu-email@dominio.com.br)

HTTP_TIMEOUT_SEG=20
LACUNA_ALARME_SEG=300
PARTICOES_FUTURAS=2
LOG_JSON=true
