# Copie para .env na raiz. Lido automaticamente pelo compose.
#
# Duas senhas, dois papéis. POSTGRES_USER é dono/superusuário e só roda
# migrations; a aplicação conecta como clima_app, que é NOSUPERUSER/NOBYPASSRLS.
# Superusuário ignora RLS por completo — ver api/db/init/10-papel-app.sh.
#
# Ambas precisam bater com as URLs em api/.env. Evite apóstrofo em
# CLIMA_APP_PASSWORD (vai para dentro de um comando SQL no initdb).

POSTGRES_DB=clima
POSTGRES_USER=clima_owner
POSTGRES_PASSWORD=TROQUE_SENHA_DO_DONO
CLIMA_APP_PASSWORD=TROQUE_SENHA_DO_APP
